// Auto-generated by minty — compile with `typst compile dist/ice_cream.typ dist/ice_cream.pdf`
#set page(
  paper: "a4",
  margin: (x: 16mm, y: 16mm),
  header: context {
    if counter(page).get().first() > 1 [
      #set text(size: 8.5pt, fill: rgb("#57534E"))
      1.2L Ice Cream & Sorbet Canonical Book #h(1fr) All weights in grams
    ]
  },
  footer: context [
    #set text(size: 8.5pt, fill: rgb("#57534E"))
    Reviewed: {{ reviewed_count }} / {{ recipes | length }} #h(1fr) Page #counter(page).display("1 of 1", both: true)
  ]
)
#set text(font: ("DM Sans", "DejaVu Sans"), size: 9.5pt, fill: rgb("#1C1917"))
#set par(leading: 0.58em)

#block(
  width: 100%,
  inset: 14pt,
  radius: 6pt,
  fill: rgb("#F7F2E9"),
  stroke: 0.8pt + rgb("#E7E0D3"),
)[
  #text(size: 19pt, weight: "bold")[1.2L Ice Cream & Sorbet Canonical Book] \
  #v(2pt)
  #text(size: 9.5pt, fill: rgb("#57534E"))[
    Normalized in grams for a 1.2L machine · {{ reviewed_count }} Reviewed · {{ unreviewed_count }} Unreviewed
  ]
]

#v(8pt)

{% for b in bases %}
#block(
  width: 100%,
  breakable: false,
  inset: 10pt,
  radius: 5pt,
  stroke: 0.7pt + rgb("#D6CFC2"),
)[
  #text(size: 11.5pt, weight: "bold")[{{ b.name }} — Multiplier Table] \
  #text(size: 8.5pt, fill: rgb("#57534E"))[{{ b.description }} Split *{{ b.yield_scales[1] }}* per flavor tub.]
  #v(4pt)
  #table(
    columns: (1.6fr, 1fr, 1fr, 1fr, 1fr),
    inset: 5pt,
    stroke: 0.4pt + rgb("#E7E0D3"),
    align: (left, right, right, right, right),
    [*Ingredient*], [*1×*], [*2×*], [*3×*], [*4×*],
    {% for ing in b.ingredients -%}
    [{{ ing.name }}], [{{ ing.scales[1] }}], [{{ ing.scales[2] }}], [{{ ing.scales[3] }}], [{{ ing.scales[4] }}],
    {% endfor -%}
    [*Total / Split*], [*{{ b.yield_scales[1] }}*], [*{{ b.yield_scales[2] }}*], [*{{ b.yield_scales[3] }}*], [*{{ b.yield_scales[4] }}*],
  )
]
{% endfor %}

#v(8pt)

{% for r in recipes %}
#block(
  width: 100%,
  breakable: false,
  inset: 11pt,
  radius: 5pt,
  fill: rgb("#FFFDF9"),
  stroke: 0.8pt + rgb("{% if r.reviewed %}#D6CFC2{% else %}#F59E0B{% endif %}"),
)[
  #grid(
    columns: (1fr, auto),
    [
      #text(size: 13pt, weight: "bold")[{{ r.name }}]
      #h(6pt)
      #text(size: 8.5pt, fill: rgb("#57534E"))[({{ r.category }})]
      {% if not r.reviewed %}
      #h(4pt)
      #text(size: 8pt, weight: "bold", fill: rgb("#B45309"))[\[UNREVIEWED\]]
      {% endif %}
    ],
    [#text(size: 9pt, weight: "bold", fill: rgb("#57534E"))[{{ r.total_grams_fmt }}]]
  )
  {% if r.notes %}
  #v(2pt)
  #text(size: 8.5pt, style: "italic", fill: rgb("#57534E"))[{{ r.notes }}]
  {% endif %}
  #v(6pt)
  #grid(
    columns: (0.95fr, 1.45fr),
    gutter: 14pt,
    [
      #text(size: 8pt, weight: "bold", fill: rgb("#57534E"))[INGREDIENTS]
      #v(2pt)
      #table(
        columns: (1fr, auto),
        inset: (x: 2pt, y: 3.5pt),
        stroke: (bottom: 0.3pt + rgb("#E7E0D3")),
        align: (left, right),
        {% for ing in r.ingredients -%}
        [{{ ing.name }}{% if ing.note %} #text(size: 7.5pt, fill: rgb("#57534E"))[({{ ing.note }})]{% endif %}], [*{{ ing.display }}*],
        {% endfor %}
      )
    ],
    [
      #text(size: 8pt, weight: "bold", fill: rgb("#57534E"))[METHOD]
      #v(2pt)
      {% for step in r.expanded_steps -%}
      *{{ loop.index }}. {{ step.title }}*{% if step.timer_label %} #text(size: 8pt, fill: rgb("#15803D"))[({{ step.timer_label }})]{% endif %}{% if step.inputs_inline %} — #text(size: 8.5pt, fill: rgb("#57534E"))[{{ step.inputs_inline }}]{% endif %} \
      #text(size: 8.8pt)[{{ step.do }}]
      #v(3pt)
      {% endfor %}
    ]
  )
]
#v(7pt)
{% endfor %}
